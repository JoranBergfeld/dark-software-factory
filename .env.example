# Owner-level App Configuration index used by `dsf list`, `dsf charter`, and `dsf-runtime --product`.
DSF_OWNER_APPCONFIG_ENDPOINT=

# Product runtime settings, normally published by `dsf new` into the owner index.
AZURE_APPCONFIG_ENDPOINT=
AZURE_COSMOS_ENDPOINT=
AZURE_KEYVAULT_URI=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
APPLICATIONINSIGHTS_CONNECTION_STRING=
GITHUB_REPOSITORY=
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_SECRET=github-app-private-key

# Manual gates for live side effects.
DSF_CONFIRM_LIVE_FILING=false
DSF_CONFIRM_LIVE_OUTCOMES=false

# Served source-agent endpoints. Use the template or per-kind overrides.
DSF_SOURCE_AGENT_ENDPOINT_TEMPLATE=
DSF_SOURCE_AGENT_ENDPOINT_AZUREMONITOR=
DSF_SOURCE_AGENT_ENDPOINT_FOUNDRYIQ=
DSF_SOURCE_AGENT_ENDPOINT_WEBIQ=

# Source-agent roster and policy are stored in product App Configuration.
DSF_CREATION_MATURITY=low
DSF_ASSIGN_CLOUD_AGENT=false

# Typed Azure Monitor source integration.
DSF_AZUREMONITOR_WORKSPACE_ID=
DSF_AZUREMONITOR_QUERY=

# Typed FoundryIQ source integration.
DSF_FOUNDRYIQ_PROJECT_ENDPOINT=
DSF_FOUNDRYIQ_KNOWLEDGE_BASE=
DSF_FOUNDRYIQ_QUERY=

# Typed WebIQ source integration.
DSF_WEBIQ_QUERY=
WEBIQ_API_KEY=
WEBIQ_API_KEY_SECRET=webiq-api-key
