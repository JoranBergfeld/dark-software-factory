# Build context is limited to the .NET runtime and agent-host images.
# Everything else is excluded to keep context minimal and images lean.
.git
.github
docs
infra
node_modules
dist
local_state
.env
# Tests are never copied into runtime images.
**/tests
# Local .NET build output; the image builds fresh inside the container.
dotnet/**/bin
dotnet/**/obj
# Non-build artefacts
config
Makefile
*.md
