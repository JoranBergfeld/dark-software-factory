# Build context spans the Python members (core/, feature-council/, each a uv
# workspace member installed by path) for the agent images, and dotnet/ for
# the .NET runtime image. Everything else is excluded to keep context minimal
# and images lean.
.git
.github
.venv
**/__pycache__
.pytest_cache
.ruff_cache
docs
infra
node_modules
dist
local_state
*.egg-info
.env
# Tests are never copied into images (members are installed by path; wheels ship
# src/dsf only; dotnet/tests is the .NET test tree). Exclude every member's
# tests/ tree, not just a root one.
**/tests
# Local .NET build output; the image builds fresh inside the container.
dotnet/**/bin
dotnet/**/obj
# Non-build artefacts
config
Makefile
*.md
