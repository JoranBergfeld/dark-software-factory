<Project>
  <PropertyGroup>
    <BicepCommand Condition="'$(BicepCommand)' == ''">bicep</BicepCommand>
    <DsfInfrastructureRoot>$(MSBuildThisFileDirectory)../../infra/</DsfInfrastructureRoot>
    <DsfAssetOutput>$(MSBuildProjectExtensionsPath)dsf-assets/infra/</DsfAssetOutput>
  </PropertyGroup>

  <ItemGroup>
    <DsfTemplate Include="owner-keyvault;owner-secrets;main;sre-agent;copy-owner-secret;onboard-foundation;product-github-private-key;onboard-github-auth;onboard-telemetry;onboard-models;onboard-source;onboard-supplemental;onboard-preview-workloads;onboard-live;onboard-publisher" />
    <DsfTemplateSource Include="$(DsfInfrastructureRoot)**/*.bicep" />
    <Content Include="@(DsfTemplate->'$(DsfAssetOutput)%(Identity).json')"
             Link="assets/infra/%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             ExcludeFromSingleFile="true" Pack="false" />
  </ItemGroup>

  <Target Name="CompileDsfTemplates" BeforeTargets="PrepareForBuild;GetCopyToOutputDirectoryItems"
          Inputs="@(DsfTemplateSource);$(MSBuildThisFileFullPath)"
          Outputs="@(DsfTemplate->'$(DsfAssetOutput)%(Identity).json')">
    <MakeDir Directories="$(DsfAssetOutput)" />
    <Exec Command="$(BicepCommand) build &quot;$(DsfInfrastructureRoot)%(DsfTemplate.Identity).bicep&quot; --outfile &quot;$(DsfAssetOutput)%(DsfTemplate.Identity).json&quot;" />
  </Target>

  <Import Project="RuntimeBundle.targets" />

  <Target Name="ValidateDsfProvisioningBundle" BeforeTargets="PublishDsfRuntimeBundle">
    <Error Condition="!Exists('$(TargetDir)assets/infra/%(DsfTemplate.Identity).json')"
           Text="The DSF provisioning asset %(DsfTemplate.Identity).json is missing. Rebuild the CLI before publishing." />
  </Target>

</Project>
